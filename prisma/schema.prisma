generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String           @id @default(uuid())
  email                    String?          @unique
  passwordHash             String?
  telegramId               BigInt?          @unique
  username                 String?
  firstName                String?
  role                     UserRole         @default(USER)
  status                   String           @default("active")
  referralCode             String           @unique
  referredById             String?
  unpaidAffiliateBalance   Float            @default(0.0)
  lastActive               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  hasCompletedFirstDeposit Boolean          @default(false)
  offrampRequests          OfframpRequest[]
  orders                   Order[]
  referralRecordReceived   ReferralRecord?  @relation("ReferralRecordReceived")
  referralRecordsGiven     ReferralRecord[] @relation("ReferralRecordsGiven")
  refundRequests           RefundRequest[]
  savedBanks               SavedBank[]
  referrer                 User?            @relation("Referrals", fields: [referredById], references: [id])
  referrals                User[]           @relation("Referrals")
  wallet                   Wallet?

  @@index([telegramId])
  @@index([email])
  @@index([referralCode])
  @@index([referredById])
}

model Order {
  id              String          @id @default(uuid())
  userId          String
  chain           SupportedChain
  targetWallet    String
  fiatAmountNaira Decimal         @db.Decimal(12, 2)
  feeNaira        Decimal         @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  cryptoAmount    Decimal         @db.Decimal(18, 8)
  paymentRef      String          @unique
  paymentGateway  PaymentGateway
  txHash          String?
  status          OrderStatus     @default(PENDING_PAYMENT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refundRequests  RefundRequest[]

  @@index([userId])
  @@index([status])
  @@index([paymentRef])
  @@index([createdAt])
}

model WebhookLog {
  id          String         @id @default(uuid())
  paymentRef  String         @unique
  gateway     PaymentGateway
  payload     Json
  processedAt DateTime       @default(now())

  @@index([paymentRef])
}

model SystemConfig {
  id                      String   @id @default("global")
  platformFeePercent      Decimal  @default(15.00) @db.Decimal(5, 2)
  updatedAt               DateTime @updatedAt
  isVirtualAccountEnabled Boolean  @default(false)
  referralCommissionRate  Decimal  @default(20.00) @db.Decimal(5, 2)
  usdtBuyRateNgn          Decimal  @default(1550.00) @db.Decimal(10, 2)
}

model ChainConfig {
  id             String         @id @default(uuid())
  chain          SupportedChain @unique
  isEnabled      Boolean        @default(true)
  minAmountNaira Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model OfframpRequest {
  id                String            @id @default(uuid())
  userId            String
  status            OfframpStatus     @default(PENDING_VERIFICATION)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bybitUidUsed      String
  cryptoAmount      Float
  cryptoAsset       String
  exchangeRate      Float
  ngnValue          Float
  payoutDestination PayoutDestination
  proofImageUrl     String?
  rejectionReason   String?
  savedBankId       String?
  userBybitTxId     String
  savedBank         SavedBank?        @relation(fields: [savedBankId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([savedBankId])
}

model RefundRequest {
  id         String       @id @default(uuid())
  orderId    String
  userId     String
  reason     String
  status     RefundStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model SavedBank {
  id                    String           @id @default(uuid())
  userId                String
  bankCode              String
  bankName              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String?          @unique
  isVerified            Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  offrampRequests       OfframpRequest[]
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountNumber])
  @@index([paystackRecipientCode])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  nairaBalance Float               @default(0.0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String
  amount        Float
  type          WalletTransactionType
  status        WalletTransactionStatus @default(PENDING)
  balanceBefore Float?
  balanceAfter  Float?
  reference     String                  @unique
  metadata      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  wallet        Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
}

model AccountLinkCode {
  id         String   @id @default(uuid())
  code       String   @unique
  telegramId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([code])
  @@index([telegramId])
  @@index([expiresAt])
}

model ReferralRecord {
  id          String         @id @default(uuid())
  referrerId  String
  refereeId   String         @unique
  bonusAmount Float          @default(200.0)
  status      ReferralStatus @default(PENDING)
  rewardedAt  DateTime?
  createdAt   DateTime       @default(now())
  referee     User           @relation("ReferralRecordReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  referrer    User           @relation("ReferralRecordsGiven", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([refereeId])
  @@index([status])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_VERIFIED
  DISPENSING_QUEUED
  PENDING_LIQUIDITY
  DISPENSED_SUCCESS
  FAILED_REFUND_NEEDED
  REFUNDED
}

enum SupportedChain {
  SOLANA
  BASE
  TON
  BSC
  USDT_TON
  USDT_SOL
  USDT_BSC
  USDT_BASE
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  OPAY
}

enum UserRole {
  USER
  ADMIN
}

enum OfframpStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum PayoutDestination {
  INTERNAL_WALLET
  SAVED_BANK
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum WalletTransactionType {
  REFERRAL_EARNING
  BONUS_DEPOSIT
  OFFRAMP_PAYOUT
  REFUND
  WITHDRAWAL
  GAS_PURCHASE
  DEPOSIT
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReferralStatus {
  PENDING
  REWARDED
}
