# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gasbot?schema=public"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ENABLE_BOT=true

# Payment Gateways
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
OPAY_SECRET_KEY=your_opay_secret_key_here

# Web3 Configuration - Module 6
# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_VAULT_PRIVATE_KEY=your_solana_vault_private_key_base58_encoded

# Base (EVM) Configuration
BASE_RPC_URL=https://sepolia.base.org
BASE_VAULT_PRIVATE_KEY=your_base_vault_private_key_hex_encoded

# TON Configuration
TON_RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=your_ton_api_key_optional
TON_VAULT_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# SMTP Configuration for Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@trezvor.com
ADMIN_EMAIL=admin@trezvor.com

# TON Confirmation Timeout (Optional)
TON_CONFIRMATION_MAX_ATTEMPTS=60
TON_CONFIRMATION_POLL_INTERVAL=3000
